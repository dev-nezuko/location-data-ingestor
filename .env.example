# Copy to .env for Docker Compose, or export these for a local virtualenv.

# Any long random string. Required when DEBUG is false.
SECRET_KEY=replace-with-a-long-random-string

# true enables Django debug pages and lets runserver serve the admin's CSS.
DEBUG=true

# Comma-separated host names Django will answer for.
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional outside Compose (which sets both itself):
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# Run tasks in-process instead of through the broker.
CELERY_TASK_ALWAYS_EAGER=false
